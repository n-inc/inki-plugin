{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "inki",
  "version": "1.0.0",
  "description": "Finish long writing with your AI in an editor built for it: your AI puts your draft in a note, runs a check, fixes only what you choose, and continues from your own edits.",
  "author": {
    "name": "n, Inc.",
    "email": "hello@inki.so",
    "url": "https://inki.so"
  },
  "homepage": "https://inki.so",
  "repository": "https://github.com/n-inc/inki-plugin",
  "license": "MIT",
  "keywords": ["writing", "notes", "editing", "proofreading"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Inki",
        "shortDescription": "Write and check notes in Inki",
        "developerName": "n, Inc.",
        "category": "Productivity",
        "capabilities": ["Read", "Write"],
        "websiteURL": "https://inki.so",
        "privacyPolicyURL": "https://inki.so/en/privacy",
        "termsOfServiceURL": "https://inki.so/en/terms",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
